# Copy to .env and fill in. Never commit the real .env file.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/gogain?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
NODE_ENV=development
PORT=3001
# Optional: comma-separated list of allowed frontend origins
# CORS_ORIGINS=https://gogain.co,https://gogain-frontend.vercel.app
